# Docker compose setting
COMPOSE_PATH_SEPARATOR=:
COMPOSE_DEV=docker-compose.yaml
COMPOSE_PROD=docker-compose-prod.yaml
COMPOSE_FILE=${COMPOSE_DEV}

# Basic
PROJECT_NAME="Docker Fullstack Template"
PROJECT_VERSION="1.0.0"
PROJECT_DESCRIPTION="Docker Fullstack Template"

# Timezone
TIMEZONE=UTC

# Hostname
HOSTNAME=localhost

# SSL setting
SSL_ENABLE=false
SSL_CERT_FILE=cert.pem
SSL_KEY_FILE=privkey.pem

# Backend setting
BACKEND_PORT=5000
LOG_LEVEL=INFO
SECRET_KEY=change-me
RATE_LIMIT_WHITELIST=""

# Frontend setting
FRONTEND_PORT=3000
SITE_URL=https://${HOSTNAME}:${FRONTEND_PORT}
API_HOST=${HOSTNAME}
API_PORT=${BACKEND_PORT}

# Database setting
DB_DATABASE=app
DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=rootPassword
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_MAX_OVERFLOW=20
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30

# Database backup setting
DB_BACKUP_ENABLE=true
# Schedule uses cron: minute hour day month weekday
DB_BACKUP_SCHEDULE="0 2 * * *"
DB_BACKUP_RETENTION_DAYS=7
DB_BACKUP_LOG_RETENTION_DAYS=7
DB_BACKUP_PATH="./db/backups"

# phpMyAdmin setting
PMA_PORT=8080

# Redis setting
REDIS_INSIGHT_PORT=5540
REDIS_INSIGHT_USER=
REDIS_INSIGHT_PASSWORD=
REDIS_PASSWORD=redis

# Grafana setting
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_HOST=${HOSTNAME:-localhost}
GRAFANA_PORT=8109

# OpenTelemetry setting
OTEL_ENABLE=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318

# SMTP setting
SMTP_ENABLE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Docker Fullstack Template
SMTP_ENCRYPTION=tls

# Email verification setting
EMAIL_VERIFICATION_ENABLE=false

# Registration setting
REGISTRATION_ENABLE=true

# Default admin account
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123

# Log setting
LOG_HTTP_BODY=false
LOG_HTTP_BODY_MAX_BYTES=8192
LOG_LOKI_RETENTION_DAYS=365
LOG_LOCAL_RETENTION_DAYS=7

          "editorMode": "code",
          "expr": "{job=\"backend_logs\"} != \"API RateLimit: method=\"\r\n  | level =~ `${level:regex}` \r\n  |= \"${message:pipe:.*}\"\n \r\n  | regexp `(?P<short>^.*?ipAddress=\\S+(?: status_code=\\S+)?(?: duration=\\S+)?|.*)`\r\n  | line_format `{{ regexReplaceAll \"\\\\s*traceID=\\\\w+\" (regexReplaceAll \"^\\\\d{4}-\\\\d{2}-\\\\d{2} \\\\d{2}:\\\\d{2}:\\\\d{2},\\\\d{3}\\\\s*\" (regexReplaceAll \" \\\\[(DEBUG|INFO|WARNING|ERROR|CRITICAL)\\\\]\" (regexReplaceAll \"/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\" (regexReplaceAll \"/roles/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\" (regexReplaceAll \"/users/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\" .short \"/users/{user_id}\") \"/roles/{role_id}\") \"/{id}\") \"\") \"\") \"\" }}`\r\n  | drop short",

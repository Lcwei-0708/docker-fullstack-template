local.file_match "backend_logs" {
	path_targets = [{
		__address__ = "localhost",
		__path__    = "/var/log/backend/*.log*",
		job         = "backend_logs",
	}]
}

loki.process "backend_logs" {
	forward_to = [loki.write.default.receiver]

	stage.regex {
		expression = "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2},\\d{3}) \\[(?P<level>\\w+)\\] \\[(?P<logger>[^]]+)\\] (?P<message>.*)$"
	}

	stage.timestamp {
		source   = "timestamp"
		format   = "2006-01-02 15:04:05,000"
		location = "Asia/Taipei"
	}

	stage.labels {
		values = {
			level  = "level",
			logger = "logger",
		}
	}

	stage.regex {
		expression = "API (?P<api_action>Request): method=(?P<method>\\w+) path=(?P<path>[^ ]+) ipAddress=(?P<ip_address>[^ ]+) user-agent=\"(?P<user_agent>[^\"]*)\""
	}
	stage.labels {
		values = {
			method     = "method",
			path       = "path",
			ip_address = "ip_address",
		}
	}

	stage.regex {
		expression = "API (?P<api_action>Response): method=(?P<method>\\w+) path=(?P<path>[^ ]+) ipAddress=(?P<ip_address>[^ ]+) status_code=(?P<status_code>\\d+)(?: duration=(?P<duration>\\S+))? user-agent=\"(?P<user_agent>[^\"]*)\""
	}
	stage.labels {
		values = {
			method      = "method",
			path        = "path",
			ip_address  = "ip_address",
			status_code = "status_code",
		}
	}

	stage.regex {
		expression = "API RateLimit blocked: method=(?P<method>\\w+) path=(?P<path>[^ ]+).* ipAddress=(?P<ip_address>[^ ]+)"
	}
	stage.labels {
		values = {
			method      = "method",
			path        = "path",
			ip_address  = "ip_address",
			status_code = "status_code",
		}
	}

	stage.regex {
		expression = "\\[(?P<error_code>[A-Z_]+)\\] \\| (?P<error_message>.*)"
	}
	stage.labels {
		values = {
			error_code = "error_code",
		}
	}

	stage.template {
		source   = "event_type"
		template = "{{ if eq (index .Values \"api_action\") \"Request\" }}api_request{{ else if eq (index .Values \"api_action\") \"Response\" }}api_response{{ else if index .Values \"error_code\" }}error{{ end }}"
	}
	stage.labels {
		values = {
			event_type = "event_type",
		}
	}

	stage.regex {
		expression = "traceID=(?P<traceID>\\w+)"
	}

	stage.regex {
		expression = "query=<<(?P<request_query>.*?)>>"
	}

	stage.regex {
		expression = "payload=<<(?P<payload>.*?)>>"
	}

	stage.regex {
		expression = "data=<<(?P<data>.*?)>>"
	}

	stage.label_drop {
		values = ["filename", "logstream"]
	}

	stage.structured_metadata {
		values = {
			level          = "level",
			logger         = "logger",
			timestamp      = "timestamp",
			method         = "method",
			path           = "path",
			ip_address     = "ip_address",
			user_agent     = "user_agent",
			status_code    = "status_code",
			duration       = "duration",
			error_code     = "error_code",
			error_message  = "error_message",
			traceID        = "traceID",
			request_query  = "request_query",
			payload        = "payload",
			data           = "data",
		}
	}
}

loki.source.file "backend_logs" {
	targets               = local.file_match.backend_logs.targets
	forward_to            = [loki.process.backend_logs.receiver]
	legacy_positions_file = "/tmp/positions.yaml"
	tail_from_end         = false
	encoding              = "UTF-8"
}

loki.write "default" {
	endpoint {
		url          = "http://loki:3100/loki/api/v1/push"
		tenant_id    = "default"
		batch_size   = "102KiB"
		batch_wait   = "3s"
	}
	external_labels = {}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"
		tls {
			insecure = true
		}
	}
}

prometheus.remote_write "prometheus" {
	endpoint {
		url = "http://prometheus:9090/api/v1/write"
	}
}
